# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database — PostgreSQL önerilir ama SQLite ile de test edilebilir
# 1) PostgreSQL:  DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/officialai?schema=public"
# 2) SQLite (kurulum gerektirmeyen, tek dosya): DATABASE_URL="file:./dev.db"
#    NOT: SQLite kullanmak için prisma/schema.prisma içindeki provider="postgresql" yerine provider="sqlite" yazın
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/officialai?schema=public"

# JWT
JWT_SECRET="officialai-dev-super-secret-key-please-change-in-production-32-chars-min"
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=30d

# AI Provider - Google Gemini Free Tier (ÜCRETSİZ 15 RPM - 1 milyon token)
# API anahtarınızı al: https://makersuite.google.com/app/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=""

# Cloudinary - Ücretsiz katman kullanabilirsiniz (https://cloudinary.com)
# STORAGE_MODE=local olarak bırakırsanız hiçbir API anahtarı GEREKMEZ - sunucu klasörüne kaydeder
STORAGE_MODE=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email
# EMAIL_MODE=log -> hiçbir SMTP anahtarı GEREKMEZ, doğrulama kodlarını konsola yazar
EMAIL_MODE=log
# EMAIL_USER="your-gmail@gmail.com"
# EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="OfficialAI <noreply@officialai.com>"

# CORS - Mobil uygulama için localhost IP'lerini izin ver
# "*" kullanmak development için kabul edilebilir, production'da spesifik origin yazın
CORS_ORIGIN="*"

# Rate Limiting - Free tier için daha yüksek limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
